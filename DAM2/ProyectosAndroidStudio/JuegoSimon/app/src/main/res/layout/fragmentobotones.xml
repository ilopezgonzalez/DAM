<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/botonFacil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Facil"
        android:onClick="seleccionarNivel"
        app:layout_constraintEnd_toStartOf="@+id/botonMedio"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="64dp" />

    <Button
        android:id="@+id/botonMedio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Medio"
        android:onClick="seleccionarNivel"
        app:layout_constraintEnd_toStartOf="@+id/botonDificil"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/botonFacil"
        tools:layout_editor_absoluteY="64dp" />

    <Button
        android:id="@+id/botonDificil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dificil"
        android:onClick="seleccionarNivel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/botonMedio"
        tools:layout_editor_absoluteY="64dp" />
</androidx.constraintlayout.widget.ConstraintLayout>