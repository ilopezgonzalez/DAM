<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MenuActivity">

    <Button
        android:id="@+id/botonFacil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Facil"
        android:onClick="nivelFacil"
        app:layout_constraintBottom_toTopOf="@+id/botonMedio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/botonMedio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Medio"
        android:onClick="nivelMedio"
        app:layout_constraintBottom_toTopOf="@+id/botonDificil"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/botonFacil" />

    <Button
        android:id="@+id/botonDificil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dificil"
        android:onClick="nivelDificil"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/botonMedio" />
</androidx.constraintlayout.widget.ConstraintLayout>