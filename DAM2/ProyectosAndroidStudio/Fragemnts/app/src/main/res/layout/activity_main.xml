<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/LinearLayoutPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.example.fragemnts.MainActivity">
    <LinearLayout
        android:layout_marginTop="50dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <Button
            android:id="@+id/btnFragmentInicial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fragmento1"
            android:onClick="seleccionarFragmento"/>
        <Button
            android:id="@+id/btnFragmentSegundo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fragmento2"
            android:onClick="seleccionarFragmento"/>
        <Button
            android:id="@+id/btnFragmentTercero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fragmento3"
            android:onClick="seleccionarFragmento"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/LinearLayoutContenedorDeFragments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10"
        android:orientation="horizontal">
    </LinearLayout>
    <LinearLayout
        android:id="@+id/LinearLayoutContenedorDeFragments2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10"
        android:orientation="horizontal">
    </LinearLayout>
</LinearLayout>
