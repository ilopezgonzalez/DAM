	<queryString>
		<![CDATA[SELECT
     country.`Code` AS country_Code,
     country.`Name` AS country_Name,
     country.`Population` AS country_Population,
     country.`LocalName` AS country_LocalName,
     countrylanguage.`CountryCode` AS countrylanguage_CountryCode,
     countrylanguage.`Language` AS countrylanguage_Language,
     countrylanguage.`IsOfficial` AS countrylanguage_IsOfficial,
if (isOfficial=1, 'Oficial', 'No oficial') as oficial,
     countrylanguage.`Percentage` AS countrylanguage_Percentage
FROM
     `country` country INNER JOIN `countrylanguage` countrylanguage ON country.`Code` = countrylanguage.`CountryCode`]]>
	</queryString>
	<field name="country_Code" class="java.lang.String"/>
	<field name="country_Name" class="java.lang.String"/>
	<field name="country_Population" class="java.lang.Integer"/>
	<field name="country_LocalName" class="java.lang.String"/>
	<field name="countrylanguage_CountryCode" class="java.lang.String"/>
	<field name="countrylanguage_Language" class="java.lang.String"/>
	<field name="countrylanguage_IsOfficial" class="java.lang.String"/>
	<field name="oficial" class="java.lang.String"/>
	<field name="countrylanguage_Percentage" class="java.math.BigDecimal"/>
	<variable name="countrylanguage_Language_1" class="java.lang.Integer" resetType="Group" resetGroup="Group1" calculation="Count">
