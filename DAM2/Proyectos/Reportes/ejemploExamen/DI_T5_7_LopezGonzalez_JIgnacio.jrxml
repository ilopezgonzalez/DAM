	<queryString>
		<![CDATA[SELECT
     articulos.`Id_articulo` AS articulos_Id_articulo,
     articulos.`Descripcion` AS articulos_Descripcion,
     articulos.`Precio` AS articulos_Precio,
     detalle_pedidos.`ID_Venta` AS detalle_pedidos_ID_Venta,
     detalle_pedidos.`ID_Articulo` AS detalle_pedidos_ID_Articulo,
     detalle_pedidos.`Precio` AS detalle_pedidos_Precio,
     detalle_pedidos.`Unidades` AS detalle_pedidos_Unidades,
     detalle_pedidos.`ID_Pedido` AS detalle_pedidos_ID_Pedido,
	(unidades*articulos.`Precio`)

FROM
     `articulos` articulos INNER JOIN `detalle_pedidos` detalle_pedidos ON articulos.`Id_articulo` = detalle_pedidos.`ID_Articulo`]]>
	</queryString>
	<field name="articulos_Id_articulo" class="java.lang.Integer"/>
	<field name="articulos_Descripcion" class="java.lang.String"/>
	<field name="articulos_Precio" class="java.math.BigDecimal"/>
	<field name="detalle_pedidos_ID_Venta" class="java.lang.Integer"/>
	<field name="detalle_pedidos_ID_Articulo" class="java.lang.Integer"/>
	<field name="detalle_pedidos_Precio" class="java.math.BigDecimal"/>
	<field name="detalle_pedidos_Unidades" class="java.lang.Integer"/>
	<field name="detalle_pedidos_ID_Pedido" class="java.lang.Integer"/>
	<field name="(unidades*articulos.`Precio`)" class="java.math.BigDecimal"/>
	<variable name="detalle_pedidos_Unidades_1" class="java.lang.Integer" resetType="Group" resetGroup="Descripcion" calculation="Sum">
		<variableExpression><![CDATA[$F{detalle_pedidos_Unidades}]]></variableExpression>
	</variable>
	<variable name="articulos_Precio_1" class="java.math.BigDecimal" resetType="Group" resetGroup="Descripcion" calculation="Highest">
		<variableExpression><![CDATA[$F{articulos_Precio}]]></variableExpression>
	</variable>
	<variable name="detalle_pedidos_Precio_1" class="java.math.BigDecimal" resetType="Group" resetGroup="Descripcion" calculation="Sum">
		<variableExpression><![CDATA[$F{detalle_pedidos_Precio}]]></variableExpression>
	</variable>
	<variable name="Total" class="java.lang.String">
		<variableExpression><![CDATA[$F{articulos_Precio}*$F{detalle_pedidos_Unidades}]]></variableExpression>
	</variable>
	<variable name="detalle_pedidos_Unidades_2" class="java.lang.Integer" resetType="Group" resetGroup="Descripcion" calculation="Sum">
		<variableExpression><![CDATA[$F{detalle_pedidos_Unidades}]]></variableExpression>
	</variable>
	<variable name="articulos_Precio_2" class="java.math.BigDecimal" resetType="Group" resetGroup="Descripcion" calculation="Highest">
		<variableExpression><![CDATA[$F{articulos_Precio}]]></variableExpression>
	</variable>
	<variable name="(unidades*articulos.`Precio`)_1" class="java.math.BigDecimal" resetType="Group" resetGroup="Descripcion" calculation="Sum">
		<variableExpression><![CDATA[$F{(unidades*articulos.`Precio`)}]]></variableExpression>
	</variable>
