	<field name="Precio_Total" class="java.math.BigDecimal"/>
	<variable name="Precio total" class="java.lang.String">
		<variableExpression><![CDATA[$F{detalle_pedidos_Precio}*$F{detalle_pedidos_Unidades}]]></variableExpression>
	</variable>
	<variable name="variable1" class="java.lang.String"/>
	<variable name="detalle_pedidos_Unidades_1" class="java.lang.Integer" calculation="Sum">
