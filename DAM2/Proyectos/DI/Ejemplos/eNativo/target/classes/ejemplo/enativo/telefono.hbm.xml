<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping>
  <class name="ejemplo.enativo.Telefono" table="telefonos">
    <id name="id" column="ID">
      <generator class="native"/>
    </id>
    <property name="numero" column="NUMERO"/>
    <many-to-one name="persona" class="ejemplo.enativo.Persona" column="PERSONA_ID"/>
  </class>
</hibernate-mapping>
