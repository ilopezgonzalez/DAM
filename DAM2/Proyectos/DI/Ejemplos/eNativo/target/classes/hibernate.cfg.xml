<?xml version="1.0" encoding="UTF-8"?>
<hibernate-configuration>
  <session-factory>
  <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
  <!-- Usamos una base de datos Mysqlllamada enativo_db en localhost -->
  <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/enativo_db?useSSL=false&amp;serverTimezone=UTC</property>
  <property name="hibernate.connection.username">root</property>
  <property name="hibernate.connection.password"></property>
  <!-- Dialect con MySQL connector) -->
  <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>
    <property name="hibernate.show_sql">true</property>
  <!-- dejamos validate para forzar uso del script SQL; cambiar a 'update' si quieres que Hibernate cree/altere tablas automáticamente -->
  <property name="hibernate.hbm2ddl.auto">create</property>
  <!-- mapping entries (si se usan ficheros .hbm.xml) -->
  <mapping resource="ejemplo/enativo/modelo/persona.hbm.xml"/>
  <mapping resource="ejemplo/enativo/modelo/direccion.hbm.xml"/>
  <mapping resource="ejemplo/enativo/modelo/telefono.hbm.xml"/>
  </session-factory>
</hibernate-configuration>
